	(text "1. Signal path: INP/INN  ->  Q1/Q2 diff pair  ->  Q11 buffer  ->  Q13 CE gain"
		(exclude_from_sim no)
		(at 276.86 167.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "26c1c795-8dbd-48b6-a7e4-e3a3c6e5fc72")
	)
	(text "    ->  Q14 buffer  ->  Q16/Q18 class-AB  ->  R17 47R  ->  OUT."
		(exclude_from_sim no)
		(at 276.86 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "705a902a-ed54-4e6c-837c-cc66475617b8")
	)
	(text "2. C7 68p (Miller, Q13 base to collector) sets the dominant pole: 11.5 MHz at 60 dB."
		(exclude_from_sim no)
		(at 276.86 173.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "537e3e00-a94c-4fc7-9412-00c576d205f5")
	)
	(text "3. BFP420 (VCEO 4.5 V) is cascoded wherever it would see more than ~4 V:"
		(exclude_from_sim no)
		(at 276.86 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82bd3291-1dde-4671-9cd7-b42fb20620ef")
	)
	(text "    Q3 over Q1, Q12 over Q11, Q15 over Q14, Q17 over Q16."
		(exclude_from_sim no)
		(at 276.86 179.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d92906a0-af36-4486-9dac-2f94c1925a42")
	)
	(text "4. Gain is set externally: non-inverting, Rf 10k / Rg 10R = 60 dB."
		(exclude_from_sim no)
		(at 276.86 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46b48375-29dd-419c-b258-2110ef2b1f2a")
	)
	(text "    Keep the feedback network low impedance."
		(exclude_from_sim no)
		(at 276.86 186.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c95e20c2-513c-4338-939b-e86ad294d5a1")
	)
	(text "5. Q19 / R12 / R13 Vbe multiplier sets the output-pair bias; R15/R16 degenerate it."
		(exclude_from_sim no)
		(at 276.86 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c4c6b15-55c0-41d0-bd54-e5ab7e084035")
	)
	(text "6. R19 is 1206 (156 mW).  R7 10k is the on-board load."
		(exclude_from_sim no)
		(at 276.86 192.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dba9a1a7-1e1f-4902-966e-16f03e24d584")
	)
	(text "7. BFP420 is SOT-343: pad 4 is a second emitter, tie it to pad 2."
		(exclude_from_sim no)
		(at 276.86 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3951655f-cea6-47a2-95f4-c45a47a0c553")
	)
	(text "8. LCSC: BFP420 C412737, MMBTH81 C190349, MMBT3904 C20526."
		(exclude_from_sim no)
		(at 276.86 198.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7be14c09-1049-40c0-85c2-f66f64214247")
	)
	(text "9. Place C8/C9 at the Q17/Q18 collectors, C10 at Q12's base, C4 at Q3's base,"
		(exclude_from_sim no)
		(at 276.86 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4cb2d4c4-c4e4-4201-8ad6-b1eef0575439")
	)
	(text "    C5 at Q15/Q17's bases; C11/C12 (10u, 25 V min) at J1."
		(exclude_from_sim no)
		(at 276.86 205.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "15f6b406-e563-4a36-9d47-38c638bfe6f8")
	)
