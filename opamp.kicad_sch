	(text "1. Signal path: INP/INN  ->  Q1/Q2 diff pair  ->  Q11 buffer  ->  Q13 CE gain"
		(exclude_from_sim no)
		(at 284.48 167.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4284ea57-37c5-4948-935f-3df4c2fe6cd9")
	)
	(text "    ->  Q14 buffer  ->  Q16/Q18 class-AB  ->  R17 47R  ->  OUT."
		(exclude_from_sim no)
		(at 284.48 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d4d4343f-fac7-4752-b3ca-59c9e3446fd5")
	)
	(text "2. C7 68p (Miller, Q13 base to collector) sets the dominant pole: 11.5 MHz at 60 dB."
		(exclude_from_sim no)
		(at 284.48 173.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e1e455e0-64f4-4c22-a42d-54c19d68606f")
	)
	(text "3. BFP420 (VCEO 4.5 V) is cascoded wherever it would see more than ~4 V:"
		(exclude_from_sim no)
		(at 284.48 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f965737b-c672-444e-8246-c99b1b7619fb")
	)
	(text "    Q3 over Q1, Q12 over Q11, Q15 over Q14, Q17 over Q16."
		(exclude_from_sim no)
		(at 284.48 179.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3806eae-6706-49da-ba9c-0e24271e3a67")
	)
	(text "4. Gain is set on the board: R24 10k from OUTA (before R17) to INN, R25 10R"
		(exclude_from_sim no)
		(at 284.48 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c1ea238-516c-4ee7-a437-ea7e5b7e7a96")
	)
	(text "    to GND = 60 dB. R17 stays outside the loop, isolating cable capacitance."
		(exclude_from_sim no)
		(at 284.48 186.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "115343d8-123c-4d6e-b91f-f440187ce48e")
	)
	(text "5. Q19 / R12 / R13 Vbe multiplier sets the output-pair bias; R15/R16 degenerate it."
		(exclude_from_sim no)
		(at 284.48 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e24f4446-10da-4744-9c94-951547d6ce77")
	)
	(text "6. R19 is 1206 (156 mW).  R7 10k is the on-board load."
		(exclude_from_sim no)
		(at 284.48 192.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae19e3a4-8bd9-4e08-a2ca-1f77e7cd6696")
	)
	(text "7. BFP420 is SOT-343: pad 4 is a second emitter, tie it to pad 2."
		(exclude_from_sim no)
		(at 284.48 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7703f9aa-88de-4047-b8bf-94f7a9cd5a6e")
	)
	(text "8. LCSC: BFP420 C412737, MMBTH81 C190349, MMBT3904 C20526."
		(exclude_from_sim no)
		(at 284.48 198.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a044d62-8474-4dd1-9823-ea9bb55eb742")
	)
	(text "9. Place C8/C9 at the Q17/Q18 collectors, C10 at Q12's base, C14 at Q15's base,"
		(exclude_from_sim no)
		(at 284.48 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a7193d2a-d4d8-46bf-8d99-e10428505115")
	)
	(text "    C5 at Q17's base, C4 at Q3's base, C13 at Q13's emitter; C11/C12 10u 25 V."
		(exclude_from_sim no)
		(at 284.48 205.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a243eca7-1a00-48b6-9d86-3cc735b01edf")
	)
	(text "10. R21-R23 33R base stoppers sit right at the Q11/Q14/Q16 base pads."
		(exclude_from_sim no)
		(at 284.48 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a6be0871-0f07-46b9-8f6b-f2a386c62819")
	)
	(text "11. J1 pinout: 1 +15V, 2 INP, 3 GND, 4 OUT, 5 INN, 6 -15V (GND between INP and OUT)."
		(exclude_from_sim no)
		(at 284.48 211.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d18e689b-42a3-447e-bb6a-a91f56f0e8c8")
	)
