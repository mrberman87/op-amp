	(text "1. Signal path: INP/INN  ->  Q1/Q2 diff pair  ->  Q11 buffer  ->  Q13 CE gain"
		(exclude_from_sim no)
		(at 284.48 167.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "067cbf05-b663-4e44-b1a2-395a809dd1ea")
	)
	(text "    ->  Q14 buffer  ->  Q16/Q18 class-AB  ->  R17 47R  ->  OUT."
		(exclude_from_sim no)
		(at 284.48 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0410871a-16c2-4b30-866d-03497912b641")
	)
	(text "2. C7 68p (Miller, Q13 base to collector) sets the dominant pole: 11.5 MHz at 60 dB."
		(exclude_from_sim no)
		(at 284.48 173.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "52d2358a-27b0-4943-b482-633781164603")
	)
	(text "3. BFP420 (VCEO 4.5 V) is cascoded wherever it would see more than ~4 V:"
		(exclude_from_sim no)
		(at 284.48 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b47fd12d-5e65-41f8-8fe7-27eaee8c9c7f")
	)
	(text "    Q3 over Q1, Q12 over Q11, Q15 over Q14, Q17 over Q16."
		(exclude_from_sim no)
		(at 284.48 179.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ef44a3b0-c871-4a39-b988-50fdd9bc7155")
	)
	(text "4. Gain is set on the board: R24 10k from OUTA (before R17) to INN, R25 10R"
		(exclude_from_sim no)
		(at 284.48 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8fab38fc-ce51-4aab-a9c3-67fd3ac6786d")
	)
	(text "    to GND = 60 dB. R17 stays outside the loop, isolating cable capacitance."
		(exclude_from_sim no)
		(at 284.48 186.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9db86e45-bc76-47a2-b329-2d6a81959891")
	)
	(text "5. Q19 / R12 / R13 Vbe multiplier sets the output-pair bias; R15/R16 degenerate it."
		(exclude_from_sim no)
		(at 284.48 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1df5cb4a-34d9-4d23-a0d7-3e73af0069c3")
	)
	(text "6. R19 is 1206 (156 mW).  R7 10k is the on-board load."
		(exclude_from_sim no)
		(at 284.48 192.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "13ae06f9-17e4-4324-8162-cd254ea9a5cd")
	)
	(text "7. BFP420 is SOT-343: pad 4 is a second emitter, tie it to pad 2."
		(exclude_from_sim no)
		(at 284.48 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6de8ce55-0ee9-4f5a-adc5-588331492c35")
	)
	(text "8. LCSC: BFP420 C412737, MMBTH81 C190349, MMBT3904 C20526."
		(exclude_from_sim no)
		(at 284.48 198.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9134f684-204c-4a81-ad76-6f3414faf296")
	)
	(text "9. Place C8/C9 at the Q17/Q18 collectors, C10 at Q12's base, C14 at Q15's base,"
		(exclude_from_sim no)
		(at 284.48 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "04f274c7-d5e5-43a6-8b24-2056df88be20")
	)
	(text "    C5 at Q17's base, C4 at Q3's base, C13 at Q13's emitter; C11/C12 10u 25 V."
		(exclude_from_sim no)
		(at 284.48 205.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "44cfbb6e-bc42-43c0-969f-5f952ca906e4")
	)
	(text "10. R21-R23 33R base stoppers sit right at the Q11/Q14/Q16 base pads."
		(exclude_from_sim no)
		(at 284.48 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aa0a44fa-6e81-484d-a2c2-2f6cbd58571f")
	)
	(text "11. J1 pinout: 1 INP, 2 GND, 3 INN, 4 OUT, 5 +15V, 6 -15V (GND guards INP)."
		(exclude_from_sim no)
		(at 284.48 211.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d29780c0-6f21-4549-b206-61b0f218f626")
	)
